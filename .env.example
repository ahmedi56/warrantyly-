# Copy to .env and fill in. Never commit .env.
# Supabase: Dashboard -> Project Settings -> API Keys. Use the PUBLISHABLE key only,
# never the secret / service_role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public web address (e.g. https://your-app.pages.dev), used for link-preview images.
EXPO_PUBLIC_SITE_URL=
# Set to true only after turning on the Google provider in Supabase (see README). Until then the Google button shows as coming soon.
EXPO_PUBLIC_GOOGLE_SIGNIN=
